<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Nothing here reaches the network, and there is no INTERNET permission: everything the app
      shows it computes locally from the platform's clock and tz database.

      USE_EXACT_ALARM rather than a runtime prompt. It is install-granted, and it is granted
      specifically to apps whose core function is an alarm clock or calendar, which this one is.
      SCHEDULE_EXACT_ALARM is declared alongside it capped at API 32, the last release before
      USE_EXACT_ALARM existed; above that the capped one is inert and the app never asks for
      anything.
    -->

    <!-- Alarm scheduling -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Rescheduling after a reboot: AlarmManager keeps nothing across one. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The ringer: looping audio and a repeating waveform with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!--
      LiveUpdateService: reposting a timer/stopwatch notification once a second is not one of
      the platform's named foreground-service categories, so it is specialUse with the
      justification property below rather than any of the other typed permissions.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Puts the dismiss screen in front of a locked phone. Degrades to a heads-up banner. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <application
        android:name=".ClockApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialClock">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MaterialClock">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- So "set an alarm for 7" from Assistant or another app lands here. -->
            <intent-filter>
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Screensaver Settings Bridge Activity.

          Launched from Android's system Screensaver settings.
          Redirects to MainActivity with OPEN_SCREENSAVER = true,
          allowing the app to open its Screensaver settings sheet directly.

          Theme.NoDisplay prevents this bridge activity from
          displaying a separate screen.
        -->
        <activity
            android:name=".screensaver.ScreensaverSettingsActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <!--
          The ringing screen. Its own task, excluded from recents: it is a modal interruption, not
          a place you navigate back to, and finding a dead alarm screen in the switcher an hour
          later is confusing. showOnLockScreen + turnScreenOn are set in code as well, because the
          manifest attributes alone do not turn a dark display on.
        -->
        <activity
            android:name=".alarm.AlarmRingActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:turnScreenOn="true"
            android:showWhenLocked="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.MaterialClock" />

        <service
            android:name=".alarm.AlarmService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".alarm.LiveUpdateService"
            android:exported="false"
            android:foregroundServiceType="specialUse">

            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the running timer/stopwatch notification's live progress and status-bar chip ticking every second while one is active." />
        </service>

        <!-- Screensaver Service Integration -->
        <service
            android:name=".screensaver.ClockDreamService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_DREAM_SERVICE">

            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/screensaver_info" />
        </service>

        <receiver
            android:name=".alarm.AlarmReceiver"
            android:exported="false"
            android:directBootAware="true">

            <intent-filter>
                <!--
                  All four mean the same thing to this app: every AlarmManager entry it owns is now
                  gone or wrong. LOCKED_BOOT_COMPLETED as well as BOOT_COMPLETED so an alarm can be
                  rearmed before the user has unlocked after a reboot.
                -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".alarm.ClockActionReceiver"
            android:exported="false" />

