<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview: Alarm Clock, 4x2.
  Shown in the widget picker. It is a plain layout: no app code runs for it, and it may only
  use the views a widget may use (no plain View, for one).
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wp_card_container"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:text="Alarm"
            android:textColor="@color/wp_on_container"
            android:textSize="16sp"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 500" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_gravity="bottom|start">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6:00"
                    android:textColor="@color/wp_on_container"
                    android:textSize="46sp"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 700"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AM"
                    android:textColor="@color/wp_on_container"
                    android:textSize="16sp"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 600"
                    android:includeFontPadding="false"
                    android:layout_marginStart="3dp" />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S M T W T F S"
                android:textColor="@color/wp_on_container"
                android:textSize="15sp"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 600"
                android:includeFontPadding="false" />
        </LinearLayout>
        <ImageView
            android:layout_width="62dp"
            android:layout_height="62dp"
            android:background="@drawable/wp_circle_primary"
            android:padding="14dp"
            android:src="@drawable/ic_widget_alarm"
            android:tint="@color/wp_on_primary"
            android:layout_gravity="bottom|end" />
    </FrameLayout>
</FrameLayout>
