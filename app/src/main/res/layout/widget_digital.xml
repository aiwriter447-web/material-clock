<?xml version="1.0" encoding="utf-8"?>
<!--
  The Digital clock widget (res/layout/widget_digital.xml).

  Two layers:
    1. digital_bg : a rounded rectangle we draw ourselves as a bitmap (so the corners can be a
                    pill on a one-row widget and a card on a taller one).
    2. text       : TextClock views. The launcher itself updates these every minute (every second
                    if seconds are on), so this app never needs to wake up.

  The sizes and colours are set at runtime in DigitalRenderer.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/digital_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/digital_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:fontFamily="@font/google_sans_flex_family"
            android:textFontWeight="600" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextClock
                android:id="@+id/digital_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="@font/google_sans_flex_family"
                android:textFontWeight="700" />

            <TextClock
                android:id="@+id/digital_ampm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="@font/google_sans_flex_family"
                android:textFontWeight="700" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
