<?xml version="1.0" encoding="utf-8"?>
<!--
  Three layers, and only the first is ours to draw.

  The face is a bitmap we render; the hands are the platform's own AnalogClock, which ticks inside
  the *launcher's* process and costs this app nothing; the date is a TextClock, which re-formats
  itself every minute in the host and rolls over at midnight with no app involvement.

  AnalogClock is match_parent so its onMeasure gets an EXACTLY spec and onDraw never scales the
  hand icons down. Its dial is set to a 1x1 transparent icon at runtime, since the face underneath
  is the dial as far as the user is concerned.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/face"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <!--
      Digit: the time as two lines of big numerals, hours over minutes. It sits BELOW the hands,
      which is why it comes first. Switched on only for that design.
    -->
    <FrameLayout
        android:id="@+id/readout_slot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextClock
            android:id="@+id/readout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.9"
            android:maxLines="2"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 800" />
    </FrameLayout>

    <!--
      The hands sit in their own box so the 2x1 capsule can squeeze them over the small dial on
      the left (setViewPadding on this box). In every other size the box has no padding and fills
      the widget.
    -->
    <FrameLayout
        android:id="@+id/hands_slot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <AnalogClock
            android:id="@+id/hands"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Orbit: the small clock in the top disc. Placed with padding, like every slot. -->
    <FrameLayout
        android:id="@+id/orbit_hands_slot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <AnalogClock
            android:id="@+id/orbit_hands"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!--
      Positioned at runtime with setViewPadding, which is API 16. setViewLayoutMargin would be
      cleaner but is API 31, and this app supports 26.
    -->
    <FrameLayout
        android:id="@+id/date_slot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextClock
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 800" />
    </FrameLayout>
    <!-- Orbit: the time in the right-hand circle ... -->
    <FrameLayout
        android:id="@+id/orbit_time_slot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextClock
            android:id="@+id/orbit_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 800" />
    </FrameLayout>

    <!-- ... and the date in the disc below. -->
    <FrameLayout
        android:id="@+id/orbit_date_slot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextClock
            android:id="@+id/orbit_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 800" />
    </FrameLayout>

    <!-- The 2x1 capsule, when it has been stretched wide: the time on the right. -->
    <FrameLayout
        android:id="@+id/pill_time_slot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <TextClock
            android:id="@+id/pill_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 700" />
    </FrameLayout>
</FrameLayout>
