<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview: World Clock, 2x1.
  Shown in the widget picker. It is a plain layout: no app code runs for it, and it may only
  use the views a widget may use (no plain View, for one).
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/wp_pill_container"
        android:clipToOutline="true">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="London"
                android:textColor="@color/wp_on_container"
                android:textSize="15sp"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 600"
                android:includeFontPadding="false" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2:01"
                    android:textColor="@color/wp_on_container"
                    android:textSize="28sp"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 700"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="am"
                    android:textColor="@color/wp_on_container"
                    android:textSize="12sp"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 700"
                    android:includeFontPadding="false"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/wp_primary"
            android:gravity="center"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="San Francisco"
                android:textColor="@color/wp_on_primary"
                android:textSize="15sp"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 600"
                android:includeFontPadding="false" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6:01"
                    android:textColor="@color/wp_on_primary"
                    android:textSize="28sp"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 700"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="am"
                    android:textColor="@color/wp_on_primary"
                    android:textSize="12sp"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 700"
                    android:includeFontPadding="false"
                    android:layout_marginStart="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
