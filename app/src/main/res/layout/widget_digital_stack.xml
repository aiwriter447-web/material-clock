<?xml version="1.0" encoding="utf-8"?>
<!--
  The Digital clock on the square card (2x2): the date, the time, and AM/PM on a line of its own
  underneath. The ids match widget_digital.xml, so DigitalRenderer fills it the same way. Sizes and
  colours are set at runtime.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/digital_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/digital_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 600" />

        <TextClock
            android:id="@+id/digital_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 700" />

        <TextClock
            android:id="@+id/digital_ampm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:fontFamily="@font/google_sans_flex"
            android:fontVariationSettings="'wght' 700" />
    </LinearLayout>
</FrameLayout>
