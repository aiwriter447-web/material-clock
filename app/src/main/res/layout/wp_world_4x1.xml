<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker preview: World Clock, 4x1.
  Shown in the widget picker. It is a plain layout: no app code runs for it.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:background="@drawable/wp_pill_container"
        android:clipToOutline="true">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Seoul"
                android:textColor="@color/wp_on_container"
                android:textSize="13sp"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 500"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wed, 14 Oct"
                android:textColor="@color/wp_on_container"
                android:textSize="11sp"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 450"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12:45"
                android:textColor="@color/wp_on_container"
                android:textSize="24sp"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 700"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/wp_primary"
            android:gravity="center"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="London"
                android:textColor="@color/wp_on_primary"
                android:textSize="13sp"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 500"
                android:includeFontPadding="false" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wed, 14 Oct"
                android:textColor="@color/wp_on_primary"
                android:textSize="11sp"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 450"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3:45"
                android:textColor="@color/wp_on_primary"
                android:textSize="24sp"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 700"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
