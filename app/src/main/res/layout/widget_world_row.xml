<?xml version="1.0" encoding="utf-8"?>
<!-- World Clock widget. Two panels; all sizes and colours are set in WorldClockRenderer. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/world_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/p1_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 600" />

            <TextClock
                android:id="@+id/p1_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 500" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/p1_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 700" />

                <TextClock
                    android:id="@+id/p1_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 700" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/p2_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:ellipsize="end"
                android:maxLines="1"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 600" />

            <TextClock
                android:id="@+id/p2_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:fontFamily="@font/google_sans_flex"
                android:fontVariationSettings="'wght' 500" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextClock
                    android:id="@+id/p2_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 700" />

                <TextClock
                    android:id="@+id/p2_ampm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:fontFamily="@font/google_sans_flex"
                    android:fontVariationSettings="'wght' 700" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
