<?xml version="1.0" encoding="utf-8"?>
<!--
  Google Sans Flex in the weights the widgets use, each one the same variable font file with its
  weight axis set. A widget's layout asks for a weight with android:textFontWeight and the system
  picks the matching entry here.

  This is how the weights are applied now. Putting android:fontVariationSettings straight on a text
  view did nothing on the home screen: the digital clock's time came out the plain weight however
  high the number, which is why AM/PM and the time looked too light.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:font="@font/google_sans_flex"
        android:fontStyle="normal"
        android:fontWeight="400"
        android:fontVariationSettings="'wght' 400" />
    <font
        android:font="@font/google_sans_flex"
        android:fontStyle="normal"
        android:fontWeight="500"
        android:fontVariationSettings="'wght' 500" />
    <font
        android:font="@font/google_sans_flex"
        android:fontStyle="normal"
        android:fontWeight="600"
        android:fontVariationSettings="'wght' 600" />
    <font
        android:font="@font/google_sans_flex"
        android:fontStyle="normal"
        android:fontWeight="700"
        android:fontVariationSettings="'wght' 700" />
    <font
        android:font="@font/google_sans_flex"
        android:fontStyle="normal"
        android:fontWeight="800"
        android:fontVariationSettings="'wght' 800" />
</font-family>
