<?xml version="1.0" encoding="utf-8"?>
<!--
  The gradient itself is now the background layer (previously a flat @color), since the reference
  design is a glowing blue field with the clock face floating on it — a flat colour behind a
  separate white dial does not produce that look; the glow has to be the background.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="34"
                android:centerY="30"
                android:gradientRadius="98"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#5AA3FF" />
                <item android:offset="0.5" android:color="#3E7BFA" />
                <item android:offset="1" android:color="#1D3FBF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
