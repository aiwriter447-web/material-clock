  <!-- White Solid Dial -->
  <path
      android:fillColor="#F6F6F6"
      android:pathData="M 54,28.8 A 25.2,25.2 0 1,1 53.9,28.8 Z" />

  <!-- Second Hand (Bottom Layer) -->
  <path
      android:strokeColor="#E44DAE"
      android:strokeWidth="2.79"
      android:strokeLineCap="round"
      android:pathData="M 54,54 L 54,73.2" />

  <!-- Minute Hand (Middle Layer) -->
