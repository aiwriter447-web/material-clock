<?xml version="1.0" encoding="utf-8"?>
<!--
  Third pass, matching the reference supplied directly: two hands meeting at a pink-purple pivot,
  four tick marks, on transparent (the glow is now ic_launcher_background, not drawn here).

    - Hour hand: short, thick, dark navy, pointing lower-left.
    - Minute hand: long, thin, white-to-pink gradient, pointing upper-right.
    - Pivot: its own small radial pink-to-purple gradient circle, drawn last so it sits on top of
      both hands' bases, matching the reference's glowing-joint look.
    - Four tick marks at 12/3/6/9, pale lavender, short rounded bars near the rim.

  Geometry stays inside the 66 dp safe circle (radius 33, centred 54,54) — same reasoning as both
  earlier passes: a hand-tip or tick clipped by an aggressive launcher mask reads as broken.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Ticks: 12, 6, 3, 9 — short pale-lavender rounded bars just inside the safe rim. -->
    <path android:fillColor="#E4E8FF" android:pathData="M51.5,23 h5 a2.5,2.5 0 0,1 2.5,2.5 v8 a2.5,2.5 0 0,1 -2.5,2.5 h-5 a2.5,2.5 0 0,1 -2.5,-2.5 v-8 a2.5,2.5 0 0,1 2.5,-2.5 Z" />
    <path android:fillColor="#E4E8FF" android:pathData="M51.5,72 h5 a2.5,2.5 0 0,1 2.5,2.5 v8 a2.5,2.5 0 0,1 -2.5,2.5 h-5 a2.5,2.5 0 0,1 -2.5,-2.5 v-8 a2.5,2.5 0 0,1 2.5,-2.5 Z" />
    <path android:fillColor="#E4E8FF" android:pathData="M23,51.5 v5 a2.5,2.5 0 0,0 2.5,2.5 h8 a2.5,2.5 0 0,0 2.5,-2.5 v-5 a2.5,2.5 0 0,0 -2.5,-2.5 h-8 a2.5,2.5 0 0,0 -2.5,2.5 Z" />
    <path android:fillColor="#E4E8FF" android:pathData="M72,51.5 v5 a2.5,2.5 0 0,0 2.5,2.5 h8 a2.5,2.5 0 0,0 2.5,-2.5 v-5 a2.5,2.5 0 0,0 -2.5,-2.5 h-8 a2.5,2.5 0 0,0 -2.5,2.5 Z" />

    <!-- Hour hand: short, heavy, dark navy — pointing lower-left. -->
    <path
        android:pathData="M33,71 L54,54"
        android:strokeColor="#16213D"
        android:strokeWidth="15"
        android:strokeLineCap="round" />

    <!-- Minute hand: long, thin, brightening from white toward a pink tip — pointing upper-right. -->
    <path android:pathData="M54,54 L85,27" android:strokeWidth="11" android:strokeLineCap="round">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="54" android:startY="54"
                android:endX="85" android:endY="27">
                <item android:offset="0" android:color="#F4B6E6" />
                <item android:offset="0.35" android:color="#FFFFFF" />
                <item android:offset="1" android:color="#FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Pivot: drawn last, on top of both hand bases — its own pink-to-purple glow. -->
    <path android:pathData="M54,54 m-9,0 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="9">
                <item android:offset="0" android:color="#F0A8E0" />
                <item android:offset="1" android:color="#7B5FE0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
