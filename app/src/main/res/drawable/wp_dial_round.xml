<?xml version="1.0" encoding="utf-8"?>
<!--
  A plain round dial for the small clock in the 2x1 capsule.
  Drawn 300dp wide on purpose: AnalogClock never enlarges a picture, it only shrinks it to fit,
  so a small one would sit tiny in the middle of the preview. Big, it is shrunk to fill it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="300dp"
    android:height="300dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:fillColor="@color/wp_face"
        android:pathData="M50,50 m-49.5,0 a49.5,49.5 0 1,0 99,0 a49.5,49.5 0 1,0 -99,0" />
</vector>
