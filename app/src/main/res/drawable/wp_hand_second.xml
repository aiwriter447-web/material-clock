l<?xml version="1.0" encoding="utf-8"?>
<!-- The seconds dot: a dot near the rim that the clock turns once a minute. 
  Drawn 300dp wide on purpose: AnalogClock never enlarges a picture, it only shrinks it to fit,
  so a small one would sit tiny in the middle of the preview. Big, it is shrunk to fill it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="300dp"
    android:height="300dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <path
        android:fillColor="@color/wp_dot"
        android:pathData="M50,13 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
</vector>
