<?xml version="1.0" encoding="utf-8"?>
<!--
  Alarm Clock, added as 4x2. The size it starts at is the target cell size; it can be resized
  between 2x1 and 4x2 afterwards (a cell is about 70 to 85dp, so the limit is a generous 400 x 200 dp).
  updatePeriodMillis is 0: the launcher's own clock views keep the time ticking.
  configure is fully qualified. A leading dot would be a silent ActivityNotFoundException.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="200dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_clock_placeholder"
    android:previewLayout="@layout/wp_alarm_4x2"
    android:configure="app.materialclock.widget.WidgetOptionsActivity"
    android:widgetFeatures="reconfigurable" />
