<?xml version="1.0" encoding="utf-8"?>
<!--
  updatePeriodMillis is 0 on purpose: the hands are ticked by the host's own AnalogClock and the
  time and date by its TextClock, so this app never needs a periodic wakeup.

  configure is fully qualified. A leading dot here is a silent ActivityNotFoundException.

  SIZE (changed): the default is now 2x2 (targetCell 2x2) instead of 3x3, and the widget can be
  resized from 2x1 (110 x 40 dp) up to 4x2 (250 x 110 dp). A cell is roughly 70dp: n cells =
  70*n - 30 dp.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_clock_placeholder"
    android:previewLayout="@layout/widget_clock_preview"
    android:description="@string/widget_description"
    android:configure="app.materialclock.widget.ClockWidgetConfigActivity"
    android:widgetFeatures="reconfigurable" />
